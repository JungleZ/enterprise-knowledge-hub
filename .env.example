# 模板：复制为 .env 并填入真实值（.env 已被 .gitignore 排除）。
# 本地一键启动：保留 COMPOSE_PROFILES=embedded-pg 自动带嵌入式 Postgres。
# 生产服务器复用宿主 PG：删掉 COMPOSE_PROFILES 行，并新增 DATABASE_DSN 指向宿主库。
# 生产部署时在服务器上重新生成随机值（见 DEPLOY.md），不要使用这里的占位默认值。
COMPOSE_PROFILES=embedded-pg
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-in-production
MEILI_MASTER_KEY=change-me-in-production
MEILI_API_KEY=change-me-in-production
LLM_API_KEY=
# 向量检索（embedding）。留空 = 关闭（离线 BM25）。填 key 即启用。
# 当前可用方案：Cohere embed-multilingual-v3.0（OpenAI 兼容 /v1/embeddings，1024 维）。
# 该向量余弦分数对本语料区分度好：离题 <=~0.52、范围内 >=~0.55，故 MISS_THRESHOLD 取 0.53。
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embed-multilingual-v3.0
EMBEDDING_BASE_URL=https://api.cohere.ai/v1
WEB_SEARCH_API_KEY=
BOT_PLATFORM=wecom
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# Rerank（跨编码器重排，可选）。留空 = 关闭，仅用 BM25+向量 RRF 合并。
# 用 OpenAI 兼容接口（provider=openai）：Jina jina-reranker-v2-base-multilingual 免费且不限速，
# 用于重排检索候选、提升喂给 LLM 的上下文质量（不再受 Cohere trial 10次/分钟限制）。
# Cohere reranker-v3.5 区分度更好但 trial 限速 10/min，开启时客户端已做限速+重试+降级。
RERANK_ENABLED=true
RERANK_PROVIDER=openai
RERANK_BASE_URL=https://api.jina.ai/v1
RERANK_MODEL=jina-reranker-v2-base-multilingual
RERANK_TOP_N=4
RERANK_API_KEY=
# 未命中判定（OR 逻辑，命中其一即视为无答案拒答）：
#   1) 向量余弦 < MISS_THRESHOLD（主信号，免限流，对 Cohere 向量本语料取 0.53）
#   2) Rerank 分数 < RERANK_MISS_THRESHOLD（次信号，仅当重排器返回有区分度的分数时生效）
MISS_THRESHOLD=0.53
RERANK_MISS_THRESHOLD=0.05
# 生产建议：
AUTH_ALLOW_REGISTER=true
SEED_DATA=true