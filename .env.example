# 模板：复制为 .env 并填入真实值（.env 已被 .gitignore 排除）。
# 本地一键启动：保留 COMPOSE_PROFILES=embedded-pg 自动带嵌入式 Postgres。
# 生产服务器复用宿主 PG：删掉 COMPOSE_PROFILES 行，并新增 DATABASE_DSN 指向宿主库。
# 生产部署时在服务器上重新生成随机值（见 DEPLOY.md），不要使用这里的占位默认值。
COMPOSE_PROFILES=embedded-pg
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-in-production
MEILI_MASTER_KEY=change-me-in-production
MEILI_API_KEY=change-me-in-production
LLM_API_KEY=
WEB_SEARCH_API_KEY=
BOT_PLATFORM=wecom
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# 生产建议：
AUTH_ALLOW_REGISTER=true
SEED_DATA=true