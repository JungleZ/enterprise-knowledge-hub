# 模板：复制为 .env 并填入真实值（.env 已被 .gitignore 排除）。
# 本地一键启动：保留 COMPOSE_PROFILES=embedded-pg 自动带嵌入式 Postgres。
# 生产服务器复用宿主 PG：删掉 COMPOSE_PROFILES 行，并新增 DATABASE_DSN 指向宿主库。
# 生产部署时在服务器上重新生成随机值（见 DEPLOY.md），不要使用这里的占位默认值。
COMPOSE_PROFILES=embedded-pg
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-in-production
MEILI_MASTER_KEY=change-me-in-production
MEILI_API_KEY=change-me-in-production
LLM_API_KEY=
# 向量检索（embedding）。留空 = 关闭（离线 BM25）。填 key 即启用。
# 演示用 Jina jina-embeddings-v3（1024 维，免费，免实名）：https://jina.ai 注册拿 key。
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_BASE_URL=https://api.jina.ai/v1
WEB_SEARCH_API_KEY=
BOT_PLATFORM=wecom
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# Rerank（跨编码器重排，可选）。留空 = 关闭，仅用 BM25+向量 RRF 合并。
RERANK_ENABLED=false
RERANK_PROVIDER=cohere
RERANK_BASE_URL=https://api.cohere.ai/v1
RERANK_MODEL=rerank-v3.5
RERANK_TOP_N=4
RERANK_API_KEY=
# 未命中阈值：向量余弦低于 MISS_THRESHOLD 视为无答案（离题拒答）。
# 开启 Rerank 后改用跨编码器相关性分数，阈值看 RERANK_MISS_THRESHOLD。
MISS_THRESHOLD=0.25
RERANK_MISS_THRESHOLD=0.1
# 生产建议：
AUTH_ALLOW_REGISTER=true
SEED_DATA=true